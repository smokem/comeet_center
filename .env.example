# -----------------------------------------------------------------------
# Firebase client SDK  (copy values from Firebase Console → Project settings)
# -----------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# -----------------------------------------------------------------------
# API base URL
#   Development  → http://localhost:5001/<project-id>/europe-west1/api
#   Production   → leave empty (Hosting rewrites /api/** to the Function)
# -----------------------------------------------------------------------
VITE_API_URL=http://localhost:5001/commit-8da1d/europe-west1/api

# -----------------------------------------------------------------------
# EmailJS — contact form  (https://www.emailjs.com)
#   Service ID  → EmailJS dashboard → Email Services
#   Template ID → EmailJS dashboard → Email Templates
#   Public key  → EmailJS dashboard → Account → API Keys
# -----------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=service_bb3m7vm
VITE_EMAILJS_TEMPLATE_ID=your-template-id
VITE_EMAILJS_PUBLIC_KEY=H2Wj9cZD_jHFv1Dmq
