# -----------------------------------------------------------------------
# Legacy Express backend — kept for local development and unit tests.
# For production, all API traffic is handled by the Cloud Function in
# functions/ and this server is not deployed.
# -----------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------
# Firebase Admin SDK  (only needed if you want the Express dev server to
# read from Firestore instead of the in-memory fallback)
# -----------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY=your-service-account-private-key-with-escaped-newlines

# -----------------------------------------------------------------------
# Cloudinary (optional)
# -----------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=comeet
