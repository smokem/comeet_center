{
  "_comment": "Hosting is NOT used. Canonical deployment target is Vercel (auto-deploys from main branch). This file is kept only for Firebase Functions, Firestore rules/indexes, and local emulator config.",
  "functions": [
    {
      "source": "functions",
      "codebase": "api",
      "ignore": ["node_modules", ".git", "scripts"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
